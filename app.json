{
  "expo": {
    "name": "Amozart",
    "slug": "mozart_mobile_app",
    "scheme": "amozart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/splash.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6739B7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.amozart",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We need access to your photo library so you can upload pictures.",
        "NSCameraUsageDescription": "We need access to your camera so you can take pictures."
      }
    },
    "android": { 
      "icon": "./assets/splash.png",
      "backgroundColor": "#6739B7",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#6739B7"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.amozart"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-document-picker",
      "expo-image-picker",
      "expo-localization",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "5a4f94d0-e946-4602-b861-40509154e75b"
      }
    }
  }
}
